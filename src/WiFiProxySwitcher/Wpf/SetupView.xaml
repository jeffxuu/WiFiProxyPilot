<UserControl x:Class="WiFiProxySwitcher.SetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WiFiProxySwitcher">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{local:Loc SetupWelcome}" Style="{StaticResource Title}"/><TextBlock Text="{local:Loc SetupIntro}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20"/>
 <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="{local:Loc SetupProxy}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="{local:Loc SetupSource}" Margin="0,0,0,12"/><TextBlock Text="{local:Loc ProxyPort}" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:Loc SetupPort}" Width="180" HorizontalAlignment="Left"/><TextBlock Text="{local:Loc SetupPortHelp}" Style="{StaticResource Caption}"/></StackPanel></Border>
 <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="{local:Loc SetupRules}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="{local:Loc SetupRulesHelp}" Style="{StaticResource Caption}" Margin="0,0,0,12"/><Button Content="{local:Loc ConfigureRules}" Command="{Binding Navigate}" CommandParameter="Rules" HorizontalAlignment="Left"/><TextBlock Text="{Binding DraftNetworks}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
 <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="{local:Loc SetupConfirm}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="{local:Loc SetupConfirmHelp}" Style="{StaticResource Caption}" Margin="0,0,0,16"/><WrapPanel><Button Content="{local:Loc ConfirmEnable}" Style="{StaticResource Primary}" Command="{Binding Action}" CommandParameter="enable-setup" IsEnabled="{Binding AutomaticControlEnabled}" AutomationProperties.AutomationId="ConfirmEnable"/><Button Content="{local:Loc SetupLater}" Command="{Binding Navigate}" CommandParameter="Dashboard"/></WrapPanel></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
