<UserControl x:Class="WiFiProxySwitcher.SetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="一分钟开始使用" Style="{StaticResource Title}"/><TextBlock Text="根据 Wi-Fi 自动切换 Windows 手动代理。本工具不自带 VPN 或代理服务器。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20"/>
 <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="1  配置代理" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="地址来源：当前 Wi-Fi IPv4 默认网关" Margin="0,0,0,12"/><TextBlock Text="代理端口" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="首次配置代理端口" Width="180" HorizontalAlignment="Left"/><TextBlock Text="默认 7890。请先在手机或网关设备开启代理服务。默认网关不一定提供代理。" Style="{StaticResource Caption}"/></StackPanel></Border>
 <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="2  选择免代理 Wi-Fi" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="可以暂时不添加。公司、家庭及其他网络名称均由你管理，所有规则都可编辑或删除。" Style="{StaticResource Caption}" Margin="0,0,0,12"/><Button Content="配置 Wi-Fi 规则" Command="{Binding Navigate}" CommandParameter="Rules" HorizontalAlignment="Left"/><TextBlock Text="{Binding Rules.Names.Count, StringFormat=草稿中有 {0} 个网络}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
 <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="3  确认开启" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="将安装当前用户的独立后台及登录任务。规则中的 Wi-Fi 关闭手动代理；其他网络使用当前网关和端口。安装前手动代理会安全备份，PAC 和自动检测保留。" Style="{StaticResource Caption}" Margin="0,0,0,16"/><WrapPanel><Button Content="确认并开启自动切换" Style="{StaticResource Primary}" Command="{Binding Action}" CommandParameter="enable-setup"/><Button Content="稍后配置" Command="{Binding Navigate}" CommandParameter="Dashboard"/></WrapPanel></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
