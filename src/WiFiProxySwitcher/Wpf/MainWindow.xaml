<Window x:Class="WiFiProxySwitcher.PilotWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WiFiProxySwitcher"
 Title="{local:Loc WindowTitle}" Width="980" Height="660" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" AutomationProperties.AutomationId="PilotWindow">
 <!-- Windows owns the entire non-client frame: native caption controls, Snap, sizing and taskbar work area. -->
 <Border Background="{DynamicResource Canvas}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
 <Grid Margin="12,0,12,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="10,24,4,24"><TextBlock Text="WiFi Proxy Pilot" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{local:Loc BrandSubtitle}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
 <StackPanel Grid.Row="1"><TextBlock Text="{local:Loc NavNetwork}" Style="{StaticResource SidebarLabel}"/>
 <local:CommandRadioButton x:Name="NavOverview" AutomationProperties.AutomationId="NavOverview" AutomationProperties.Name="{local:Loc NavOverview}" IsChecked="True" Style="{StaticResource NavigationItem}" GroupName="Nav" Command="{Binding Navigate}" CommandParameter="Dashboard"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="{DynamicResource NavIconSurface}"><Path Data="{StaticResource OverviewIcon}" Style="{StaticResource Glyph}"/></Border><TextBlock Text="{local:Loc NavOverview}" VerticalAlignment="Center"/></StackPanel></local:CommandRadioButton>
 <local:CommandRadioButton x:Name="NavRules" AutomationProperties.AutomationId="NavRules" AutomationProperties.Name="{local:Loc NavRules}" Style="{StaticResource NavigationItem}" GroupName="Nav" Command="{Binding Navigate}" CommandParameter="Rules"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="{DynamicResource NavIconSurface}"><Path Data="{StaticResource WifiIcon}" Style="{StaticResource Glyph}"/></Border><TextBlock Text="{local:Loc NavRules}" VerticalAlignment="Center"/></StackPanel></local:CommandRadioButton>
 <TextBlock Text="{local:Loc NavApplication}" Style="{StaticResource SidebarLabel}" Margin="10,22,0,7"/>
 <local:CommandRadioButton x:Name="NavSettings" AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="{local:Loc NavSettings}" Style="{StaticResource NavigationItem}" GroupName="Nav" Command="{Binding Navigate}" CommandParameter="Settings"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="{DynamicResource NavIconSurface}"><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource Glyph}"/></Border><TextBlock Text="{local:Loc NavSettings}" VerticalAlignment="Center"/></StackPanel></local:CommandRadioButton>
 <local:CommandRadioButton x:Name="NavLogs" AutomationProperties.AutomationId="NavLogs" AutomationProperties.Name="{local:Loc NavLogs}" Style="{StaticResource NavigationItem}" GroupName="Nav" Command="{Binding Navigate}" CommandParameter="Logs"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="{DynamicResource NavIconSurface}"><Path Data="{StaticResource LogsIcon}" Style="{StaticResource Glyph}"/></Border><TextBlock Text="{local:Loc NavLogs}" VerticalAlignment="Center"/></StackPanel></local:CommandRadioButton>
 </StackPanel>
 <StackPanel Grid.Row="3" Margin="10,0,0,0"><TextBlock Text="v3.3.0-beta.1" Style="{StaticResource Caption}"/><TextBlock Text="{local:Loc UserBackground}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
 </Grid></Border>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="{DynamicResource Toolbar}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><TextBlock Text="{Binding PageTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToolbarButton}" ToolTip="{local:Loc ToggleTheme}" Click="ThemeClick" AutomationProperties.AutomationId="ThemeToggle" AutomationProperties.Name="{local:Loc ToggleTheme}"><Path Data="M8,0 A8,8 0 1 0 8,16 Z M8,0 A8,8 0 0 1 8,16" Stroke="{DynamicResource Ink}" Fill="{DynamicResource Ink}" StrokeThickness="1.25" Width="16" Height="16" Stretch="Uniform"/></Button></Grid></Border>
 <Border Grid.Row="1" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="24,11"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDemo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding DemoDescription}" AutomationProperties.AutomationId="DemoBanner" AutomationProperties.Name="{Binding DemoDescription}" TextWrapping="Wrap" FontWeight="SemiBold"/></Border>
 <ContentControl Grid.Row="2" x:Name="PageHost" Margin="26,22,26,12"/>
 <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,10" Background="{DynamicResource Canvas}"><TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" AutomationProperties.AutomationId="StatusMessage" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid></Grid></Border>
</Window>
