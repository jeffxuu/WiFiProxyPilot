<UserControl x:Class="WiFiProxySwitcher.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WiFiProxySwitcher">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>

<Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Soft}" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Data="{StaticResource WifiIcon}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Accent}" Width="23" Height="23"/></Border>
<StackPanel Grid.Column="1"><TextBlock Text="{Binding DashboardNetworkTitle}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DashboardNetworkSubtitle}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
</Grid>
<Border Style="{StaticResource CardBox}" Padding="0"><StackPanel>
<Grid Margin="16,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc AutomaticSwitch}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding DashboardAutomaticStatus}" Style="{StaticResource Caption}" Margin="0,5,20,0"/></StackPanel>
<local:CommandCheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutomaticEnabled, Mode=OneWay}" Command="{Binding ToggleAutomatic}" IsEnabled="{Binding AutomaticControlEnabled}" AutomationProperties.AutomationId="AutomaticToggle" ToolTip="{Binding AutomaticLabel}" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc AutomaticSwitch}" AutomationProperties.HelpText="{local:Loc AutomaticHelp}"/>
</Grid>
<Border Style="{StaticResource Separator}"/>
<Grid Margin="16,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc ManualProxy}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding DashboardProxyStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding DashboardProxyWhy}" Style="{StaticResource Caption}" Margin="0,7,14,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DashboardProxyAddress}" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Top" Margin="12,25,0,0"/>
</Grid>
<Border Style="{StaticResource Separator}"/>
<Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{local:Loc WifiGateway}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding DashboardGateway}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
<Button Grid.Column="2" Content="{local:Loc RulesLink}" Command="{Binding Navigate}" CommandParameter="Rules" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" Padding="0,2" Margin="12,0,0,0" MinHeight="22" FontSize="12" VerticalAlignment="Center"/>
</Grid>
</StackPanel></Border>
<Grid Margin="2,4,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{local:Loc ProxyDiagnostics}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding DashboardDiagnosticStatus}" FontSize="12" VerticalAlignment="Center"/>
<Button Grid.Column="2" Content="{local:Loc CheckNow}" Command="{Binding Action}" CommandParameter="check" AutomationProperties.AutomationId="CheckNow" IsEnabled="{Binding AutomaticControlEnabled}" FontSize="12" Padding="10,3" MinHeight="26" Margin="10,0,0,0"/>
</Grid>
<WrapPanel Margin="0,14,0,0"><Button Content="{local:Loc DirectButton}" Command="{Binding Action}" CommandParameter="direct" IsEnabled="{Binding AutomaticControlEnabled}" AutomationProperties.AutomationId="RestoreDirect"/><Button Content="{local:Loc BeginSetup}" Command="{Binding Navigate}" CommandParameter="Setup"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SetupNeeded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
<Expander Header="{local:Loc DiagnosticDetails}" Margin="0,8,0,0"><StackPanel Margin="16,3,2,0"><TextBlock Text="{Binding DashboardDiagnosticDetail}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Text="{local:Loc ProxyNotInternet}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Expander>
</StackPanel></ScrollViewer></UserControl>
