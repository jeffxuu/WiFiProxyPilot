<UserControl x:Class="WiFiProxySwitcher.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="设置" Style="{StaticResource Title}"/><TextBlock Text="保持后台运行，并按你的习惯管理代理。" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
<TextBlock Text="后台与托盘" Style="{StaticResource CardTitle}" Margin="2,0,0,10"/>
<Border Style="{StaticResource CardBox}" Padding="0"><StackPanel>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="登录后自动运行监控" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.Login}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="登录后自动运行监控"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="登录后显示托盘" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.Tray}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="登录后显示托盘"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="关闭窗口时留在托盘" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="True" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="关闭只隐藏窗口；退出界面可从托盘菜单执行。" AutomationProperties.Name="关闭窗口时留在托盘"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="最小化时隐藏到托盘" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.Minimize}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="最小化时隐藏到托盘"/></Grid>
</StackPanel></Border>
<TextBlock Text="代理" Style="{StaticResource CardTitle}" Margin="2,0,0,10"/>
<Border Style="{StaticResource CardBox}" Padding="0"><StackPanel>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="地址来源" VerticalAlignment="Center"/><TextBlock Text="当前 Wi-Fi IPv4 默认网关" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="代理端口" VerticalAlignment="Center"/><TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" Width="94" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="代理端口"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="代理模式" VerticalAlignment="Center"/><Border Background="{DynamicResource Soft}" CornerRadius="6" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton Content="Strict" GroupName="Mode" Style="{StaticResource Segment}" IsChecked="{Binding Settings.Strict}"/><RadioButton Content="Safe" GroupName="Mode" Style="{StaticResource Segment}" IsChecked="{Binding Settings.Safe}"/></StackPanel></Border></Grid>
</StackPanel></Border>
<TextBlock Text="Strict 遵循规则，诊断失败只提示。Safe 在连续失败后可能回退直连，部分流量可能不经过代理。" Style="{StaticResource Caption}" Margin="2,0,0,16"/>
<WrapPanel Margin="0,0,0,16"><Button Content="保存设置" Style="{StaticResource Primary}" Command="{Binding Action}" CommandParameter="save-settings"/><Button Content="取消修改" Command="{Binding Action}" CommandParameter="cancel"/></WrapPanel>
<Expander Header="诊断、外观与高级操作"><StackPanel Margin="0,12,0,0">
<Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="诊断方式" Style="{StaticResource Caption}"/><ComboBox SelectedValue="{Binding Settings.Diagnostics}" SelectedValuePath="Content"><ComboBoxItem Content="None"/><ComboBoxItem Content="Tcp"/><ComboBoxItem Content="Http"/></ComboBox><TextBlock Text="HTTP 诊断 URL" Style="{StaticResource Caption}"/><TextBox Text="{Binding Settings.HttpUrl, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="主题" Style="{StaticResource Caption}"/><ComboBox SelectedValue="{Binding Settings.Theme}" SelectedValuePath="Content"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></StackPanel></Border>
<Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="直连会暂停管理并关闭手动代理；恢复安装前配置使用最初备份。检测到后来修改时不会自动覆盖。" Style="{StaticResource Caption}" Margin="0,0,0,12"/><WrapPanel><Button Content="恢复直连" Command="{Binding Action}" CommandParameter="direct"/><Button Content="恢复安装前配置" Command="{Binding Action}" CommandParameter="restore"/><Button Content="升级后台" Command="{Binding Action}" CommandParameter="upgrade"/><Button Content="彻底卸载" Command="{Binding Action}" CommandParameter="uninstall" Margin="0,8,0,0"/></WrapPanel></StackPanel></Border>
<TextBlock Text="{Binding Engine}" Style="{StaticResource Caption}"/>
</StackPanel></Expander></StackPanel></ScrollViewer></UserControl>
