<UserControl x:Class="WiFiProxySwitcher.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WiFiProxySwitcher">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{local:Loc NavSettings}" Style="{StaticResource Title}"/><TextBlock Text="{local:Loc SettingsIntro}" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
<Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="{local:Loc Language}" Style="{StaticResource CardTitle}"/><ComboBox SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag" AutomationProperties.AutomationId="LanguageChoice" AutomationProperties.Name="{local:Loc Language}" MinWidth="180" HorizontalAlignment="Left"><ComboBoxItem Tag="System" Content="{local:Loc LanguageSystem}"/><ComboBoxItem Tag="zh-CN" Content="简体中文"/><ComboBoxItem Tag="en-US" Content="English"/></ComboBox><TextBlock Text="{local:Loc LanguageHelp}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border>
<TextBlock Text="{local:Loc BackgroundTray}" Style="{StaticResource CardTitle}" Margin="2,0,0,10"/>
<Border Style="{StaticResource CardBox}" Padding="0"><StackPanel>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc LoginMonitor}" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.Login}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc LoginMonitor}"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc LoginTray}" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.Tray}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc LoginTray}"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc CloseTray}" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="True" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{local:Loc CloseTrayHelp}" AutomationProperties.Name="{local:Loc CloseTray}"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc MinimizeTray}" VerticalAlignment="Center"/><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.Minimize}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc MinimizeTray}"/></Grid>
</StackPanel></Border>
<TextBlock Text="{local:Loc ProxySettings}" Style="{StaticResource CardTitle}" Margin="2,0,0,10"/>
<Border Style="{StaticResource CardBox}" Padding="0"><StackPanel>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc AddressSource}" VerticalAlignment="Center"/><TextBlock Text="{local:Loc CurrentGateway}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc ProxyPort}" VerticalAlignment="Center"/><TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" Width="94" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="{local:Loc ProxyPort}" AutomationProperties.AutomationId="PortInput"/></Grid><Border Style="{StaticResource Separator}"/>
<Grid Style="{StaticResource SettingRow}"><TextBlock Text="{local:Loc ProxyMode}" VerticalAlignment="Center"/><Border Background="{DynamicResource Soft}" CornerRadius="6" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton Content="Strict" GroupName="Mode" Style="{StaticResource Segment}" IsChecked="{Binding Settings.Strict}"/><RadioButton Content="Safe" GroupName="Mode" Style="{StaticResource Segment}" IsChecked="{Binding Settings.Safe}"/></StackPanel></Border></Grid>
</StackPanel></Border>
<TextBlock Text="{local:Loc ModeHelp}" Style="{StaticResource Caption}" Margin="2,0,0,16"/>
<WrapPanel Margin="0,0,0,16"><Button Content="{local:Loc SaveSettings}" Style="{StaticResource Primary}" Command="{Binding Action}" CommandParameter="save-settings" AutomationProperties.AutomationId="SaveSettings"/><Button Content="{local:Loc CancelChanges}" Command="{Binding Action}" CommandParameter="cancel"/></WrapPanel>
<Expander Header="{local:Loc AdvancedSettings}"><StackPanel Margin="0,12,0,0">
<Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="{local:Loc DiagnosticMethod}" Style="{StaticResource Caption}"/><ComboBox SelectedValue="{Binding Settings.Diagnostics}" SelectedValuePath="Tag"><ComboBoxItem Tag="None" Content="{local:Loc DiagnosticNone}"/><ComboBoxItem Tag="Tcp" Content="{local:Loc DiagnosticTcpOption}"/><ComboBoxItem Tag="Http" Content="{local:Loc DiagnosticHttpOption}"/></ComboBox><TextBlock Text="{local:Loc ProbeUrl}" Style="{StaticResource Caption}"/><TextBox Text="{Binding Settings.HttpUrl, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{local:Loc Theme}" Style="{StaticResource Caption}"/><ComboBox SelectedValue="{Binding Settings.Theme}" SelectedValuePath="Tag" AutomationProperties.AutomationId="ThemeChoice"><ComboBoxItem Tag="System" Content="{local:Loc ThemeSystem}"/><ComboBoxItem Tag="Light" Content="{local:Loc ThemeLight}"/><ComboBoxItem Tag="Dark" Content="{local:Loc ThemeDark}"/></ComboBox></StackPanel></Border>
<Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="{local:Loc RecoveryHelp}" Style="{StaticResource Caption}" Margin="0,0,0,12"/><WrapPanel><Button Content="{local:Loc DirectButton}" Command="{Binding Action}" CommandParameter="direct" IsEnabled="{Binding AutomaticControlEnabled}"/><Button Content="{local:Loc RestoreButton}" Command="{Binding Action}" CommandParameter="restore" IsEnabled="{Binding AutomaticControlEnabled}"/><Button Content="{local:Loc UpgradeButton}" Command="{Binding Action}" CommandParameter="upgrade" IsEnabled="{Binding AutomaticControlEnabled}"/><Button Content="{local:Loc UninstallButton}" Command="{Binding Action}" CommandParameter="uninstall" IsEnabled="{Binding AutomaticControlEnabled}" Margin="0,8,0,0"/></WrapPanel></StackPanel></Border>
<TextBlock Text="{Binding Engine}" Style="{StaticResource Caption}"/>
</StackPanel></Expander></StackPanel></ScrollViewer></UserControl>
