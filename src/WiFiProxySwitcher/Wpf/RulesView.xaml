<UserControl x:Class="WiFiProxySwitcher.RulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="免代理 Wi-Fi" Style="{StaticResource Title}"/><TextBlock Text="连接这些网络时关闭 Windows 手动代理。其他 Wi-Fi 使用当前网关及指定端口。" Style="{StaticResource Caption}" Margin="0,0,0,14"/><Grid Margin="0,0,0,10"><TextBlock Text="{Binding Rules.SaveState}" Style="{StaticResource Caption}"/><TextBlock Text="所有规则均可编辑和删除" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid></StackPanel>
<Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="0"><Grid>
<ListBox x:Name="RuleList" ItemsSource="{Binding Rules.Names}" SelectedItem="{Binding Rules.Selected}" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
<ListBox.ItemTemplate><DataTemplate><Grid MinHeight="42" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="82"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Path Data="{StaticResource WifiIcon}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="免代理" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
<Button Grid.Column="3" Content="编辑" Padding="6,3" Margin="0,0,5,0" Command="{Binding DataContext.EditRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Grid.Column="4" Content="删除" Padding="6,3" Margin="0" Command="{Binding DataContext.DeleteRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rules.Names.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="暂无免代理网络" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="可以保持空名单，或添加一个 Wi-Fi。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
</Grid></Border>
<StackPanel Grid.Row="2"><TextBlock Text="网络名称" Style="{StaticResource Caption}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RuleInput" Text="{Binding Rules.Input, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="完整 Wi-Fi 名称" Margin="0,0,8,0"/><Button Grid.Column="1" Content="从当前连接添加" Command="{Binding Action}" CommandParameter="current" Margin="0"/></Grid>
<WrapPanel Margin="0,10,0,14"><Button Content="添加网络" Command="{Binding Action}" CommandParameter="add"/><Button Content="更新所选名称" Command="{Binding Action}" CommandParameter="edit"/><TextBlock Text="1–32 个 UTF-8 字节，空格会原样保留" Style="{StaticResource Caption}" VerticalAlignment="Center"/></WrapPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RuleLabel, StringFormat=当前规则：{0}}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Command="{Binding Action}" CommandParameter="cancel"/><Button Content="保存并应用" Style="{StaticResource Primary}" Command="{Binding Action}" CommandParameter="save-rules" Margin="0"/></StackPanel></Grid>
</StackPanel>
</Grid></UserControl>
