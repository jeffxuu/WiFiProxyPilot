<UserControl x:Class="WiFiProxySwitcher.RulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WiFiProxySwitcher">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="{local:Loc BypassWifi}" Style="{StaticResource Title}"/><TextBlock Text="{local:Loc RulesIntro}" Style="{StaticResource Caption}" Margin="0,0,0,14"/><Grid Margin="0,0,0,10"><TextBlock Text="{Binding Rules.SaveState}" Style="{StaticResource Caption}"/><TextBlock Text="{local:Loc RulesEditable}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid></StackPanel>
<Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="0"><Grid>
<ListBox x:Name="RuleList" ItemsSource="{Binding Rules.Names}" SelectedItem="{Binding Rules.Selected}" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
<ListBox.ItemTemplate><DataTemplate><Grid MinHeight="42" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource WifiIcon}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{local:Loc BypassTag}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
<Button Grid.Column="3" Content="{local:Loc Edit}" Padding="6,3" Margin="0,0,5,0" AutomationProperties.AutomationId="EditRule" Command="{Binding DataContext.EditRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Grid.Column="4" Content="{local:Loc Delete}" Padding="6,3" Margin="0" AutomationProperties.AutomationId="DeleteRule" Command="{Binding DataContext.DeleteRule, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rules.Names.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{local:Loc EmptyRules}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{local:Loc EmptyRulesHint}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
</Grid></Border>
<StackPanel Grid.Row="2"><TextBlock Text="{local:Loc NetworkName}" Style="{StaticResource Caption}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RuleInput" AutomationProperties.AutomationId="SsidInput" Text="{Binding Rules.Input, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:Loc FullSsid}" Margin="0,0,8,0"/><Button Grid.Column="1" Content="{local:Loc AddCurrent}" Command="{Binding Action}" CommandParameter="current" AutomationProperties.AutomationId="AddCurrentRule" Margin="0"/></Grid>
<WrapPanel Margin="0,10,0,14"><Button Content="{local:Loc AddNetwork}" Command="{Binding Action}" CommandParameter="add" AutomationProperties.AutomationId="AddRule"/><Button Content="{local:Loc UpdateSelected}" Command="{Binding Action}" CommandParameter="edit" AutomationProperties.AutomationId="UpdateRule"/><TextBlock Text="{local:Loc SsidHelp}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></WrapPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CurrentRuleLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{local:Loc Cancel}" Command="{Binding Action}" CommandParameter="cancel" AutomationProperties.AutomationId="CancelRules"/><Button Content="{local:Loc SaveApply}" Style="{StaticResource Primary}" Command="{Binding Action}" CommandParameter="save-rules" AutomationProperties.AutomationId="SaveRules" Margin="0"/></StackPanel></Grid>
</StackPanel>
</Grid></UserControl>
